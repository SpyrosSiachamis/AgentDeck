{
  "name": "terminal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first remote development console for an AI coding CLI, reachable only over a Tailscale tailnet.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build >/dev/null && node --test tests/*.test.mjs",
    "serve:tailscale": "node scripts/tailscale-serve.mjs",
    "test:live": "node scripts/e2e-live.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "ws": "^8.18.0"
  }
}
