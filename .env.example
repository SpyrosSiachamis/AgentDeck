# Copy to .env and adjust. Every value shown is the default.
# Load it with:  set -a; source .env; set +a; npm start

# ---- network -----------------------------------------------------------------
# Keep this on loopback. Tailscale Serve is what makes the app reachable, and the
# identity headers are only trustworthy while nothing else can reach the socket.
HOST=127.0.0.1
PORT=4823
# ALLOW_NON_LOOPBACK_BIND=false

# ---- workspaces and state ----------------------------------------------------
WORKSPACES_FILE=workspaces.json
STATE_DIR=.data

# ---- authorization -----------------------------------------------------------
# When true, requests without a Tailscale identity header are refused. Turn this
# on once Tailscale Serve is running; it blocks other local users on the machine
# from using the app through plain http://127.0.0.1.
REQUIRE_TAILSCALE_IDENTITY=false
# Comma-separated tailnet logins. Empty means "any user on my tailnet".
# ALLOWED_TAILSCALE_USERS=you@example.com

# ---- coding agents -----------------------------------------------------------
# Which agents the session picker offers, and which one it defaults to.
CLI_ADAPTERS=claude-code,antigravity-cli
CLI_DEFAULT_ADAPTER=claude-code

# Per-agent binary and model. Empty means "use the agent's own default".
CLAUDE_COMMAND=claude
CLAUDE_MODEL=
AGY_COMMAND=agy
AGY_MODEL=

# How much the agent may do without asking:
#   default     - ask before anything risky; approve or deny it from the phone
#   acceptEdits - edits inside the workspace go through silently (--mode accept-edits)
#   full        - never ask (--dangerously-skip-permissions)
CLI_PERMISSION_MODE=default

# Auto-deny an approval nobody answers, so a turn cannot block forever.
PERMISSION_TIMEOUT_MS=900000
# Environment variables to forward to the CLI process on top of the safe base
# set. Anything listed here is visible to the AI, including via its Bash tool.
# CLI_FORWARD_ENV=

# Google Cloud project ID if needed for Workspace accounts.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ---- limits ------------------------------------------------------------------
MAX_CONCURRENT_SESSIONS=4
SESSION_IDLE_TIMEOUT_MS=21600000
TURN_TIMEOUT_MS=1800000
SESSION_RETENTION_MS=86400000
CANCEL_GRACE_MS=8000
SHUTDOWN_GRACE_MS=5000
MAX_INSTRUCTION_CHARS=32000
MAX_EVENT_TEXT_CHARS=20000
MAX_SESSION_OUTPUT_BYTES=67108864
MAX_EVENTS_IN_MEMORY=1500
MAX_WS_PAYLOAD_BYTES=262144

# ---- logging -----------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false
